ANTHROPIC_API_KEY_QC=sk-ant-...

# Google Sheets API (see src/lib/googleSheets.ts)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_GID=
# Recommended: base64-encode the whole service account JSON key file into one line
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=
# Alternative: the email/key pair separately (private key newlines are error-prone in some UIs)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
